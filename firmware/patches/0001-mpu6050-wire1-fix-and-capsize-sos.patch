@@ -8,11 +8,34 @@
 
 #include <Adafruit_MPU6050.h>
 
+// Capsize (beacon) detection: tilt of the Z axis away from vertical
+#ifndef CAPSIZE_TILT_TRIGGER_DEG
+#define CAPSIZE_TILT_TRIGGER_DEG 70.0f // tilt above this counts as capsized
+#endif
+#ifndef CAPSIZE_TILT_CLEAR_DEG
+#define CAPSIZE_TILT_CLEAR_DEG 45.0f // tilt below this counts as upright again (hysteresis)
+#endif
+#ifndef CAPSIZE_HOLD_MS
+#define CAPSIZE_HOLD_MS 5000 // tilt must persist this long, filters out waves
+#endif
+#ifndef CAPSIZE_REPEAT_MS
+#define CAPSIZE_REPEAT_MS 60000 // resend SOS while still capsized
+#endif
+
 class MPU6050Sensor : public MotionSensor
 {
   private:
     Adafruit_MPU6050 sensor;
 
+    float filteredTiltDeg = 0;
+    uint32_t tiltSince = 0;     // millis() when tilt first exceeded trigger, 0 = not tilted
+    uint32_t uprightSince = 0;  // millis() when tilt first fell below clear, 0 = not upright
+    bool capsized = false;
+    uint32_t lastSosSentMs = 0;
+
+    void updateCapsize();
+    void sendSos(const char *reason);
+
   public:
     explicit MPU6050Sensor(ScanI2C::FoundDevice foundDevice);
     virtual bool init() override;
