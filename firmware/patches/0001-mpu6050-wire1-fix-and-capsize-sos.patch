+void MPU6050Sensor::updateCapsize()
+{
+    sensors_event_t a, g, t;
+    if (!sensor.getEvent(&a, &g, &t))
+        return;
+
+    float ax = a.acceleration.x, ay = a.acceleration.y, az = a.acceleration.z;
+    float mag = sqrtf(ax * ax + ay * ay + az * az);
+    if (mag < 1.0f) // free fall / bad read, no gravity reference
+        return;
+
+    // Angle between sensor Z axis and gravity: 0 = upright, 180 = upside down
+    float tiltDeg = acosf(fmaxf(-1.0f, fminf(1.0f, az / mag))) * 180.0f / (float)M_PI;
+    filteredTiltDeg += 0.2f * (tiltDeg - filteredTiltDeg); // low-pass against wave chop
+
+    uint32_t now = millis();
+
+    if (filteredTiltDeg > CAPSIZE_TILT_TRIGGER_DEG) {
+        uprightSince = 0;
+        if (tiltSince == 0)
+            tiltSince = now;
+        if (!capsized && now - tiltSince >= CAPSIZE_HOLD_MS) {
+            capsized = true;
+            LOG_WARN("Capsize detected, tilt=%.0f deg", filteredTiltDeg);
+            sendSos("CAPSIZE");
+        } else if (capsized && now - lastSosSentMs >= CAPSIZE_REPEAT_MS) {
+            sendSos("CAPSIZE");
+        }
+    } else if (filteredTiltDeg < CAPSIZE_TILT_CLEAR_DEG) {
+        tiltSince = 0;
+        if (capsized) {
+            if (uprightSince == 0)
+                uprightSince = now;
+            if (now - uprightSince >= CAPSIZE_HOLD_MS) {
+                capsized = false;
+                uprightSince = 0;
+                LOG_INFO("Capsize cleared, tilt=%.0f deg", filteredTiltDeg);
+                sendSos("CLEARED");
+            }
+        }
+    }
+}
+
+void MPU6050Sensor::sendSos(const char *reason)
+{
+    lastSosSentMs = millis();
+
+    double lat = 0, lon = 0;
+    meshtastic_NodeInfoLite *self = nodeDB->getMeshNode(nodeDB->getNodeNum());
+    if (self && self->has_position && (self->position.latitude_i || self->position.longitude_i)) {
+        lat = self->position.latitude_i * 1e-7;
+        lon = self->position.longitude_i * 1e-7;
+    }
+
+    meshtastic_MeshPacket *p = router->allocForSending();
+    p->decoded.portnum = meshtastic_PortNum_TEXT_MESSAGE_APP;
+    p->to = NODENUM_BROADCAST;
+    p->channel = 0;
+    p->want_ack = false;
+    p->priority = meshtastic_MeshPacket_Priority_ALERT;
+    int len = snprintf((char *)p->decoded.payload.bytes, sizeof(p->decoded.payload.bytes), "SOS %s %.7f,%.7f tilt=%.0f",
+                       reason, lat, lon, filteredTiltDeg);
+    p->decoded.payload.size = (len > 0 && (size_t)len < sizeof(p->decoded.payload.bytes)) ? len : 0;
+
+    LOG_INFO("Send %.*s", p->decoded.payload.size, p->decoded.payload.bytes);
+    service->sendToMesh(p, RX_SRC_LOCAL, true);
+
+    if (positionModule)
+        positionModule->sendOurPosition();
+}
